      },
      "totalSoles": {
        "$sum": {
          "$cond": [
            {
              "$eq": [
                "$Devices.ServicePoints.ShipOutCycles.Transactions.CurrencyCode",
                "PEN"
              ]
            },
            "$Devices.ServicePoints.ShipOutCycles.Transactions.Total",
            0
          ]
        }
      },
      "totalDolares": {
        "$sum": {
          "$cond": [
            {
              "$eq": [
                "$Devices.ServicePoints.ShipOutCycles.Transactions.CurrencyCode",
